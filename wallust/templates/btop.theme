# GENERATED FILE -- do not edit.
# Rendered by wallust into ~/.config/btop/themes/wallust.theme.
# Selected by btop.conf -> color_theme = "wallust".

theme[main_bg]="{{color0 | lower}}"
theme[main_fg]="{{color7 | lower}}"
theme[title]="{{color2 | lower}}"
theme[hi_fg]="{{color1 | lower}}"
theme[selected_bg]="{{color8 | lower}}"
theme[selected_fg]="{{color2 | lower}}"
theme[inactive_fg]="{{color8 | lower}}"
