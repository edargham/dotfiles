# Temperature gradient: cool -> hot
theme[temp_start]="{{color4 | lower}}"
theme[temp_mid]="{{color3 | lower}}"
theme[temp_end]="{{color1 | lower}}"

# CPU load gradient
theme[cpu_start]="{{color2 | lower}}"
