#!/usr/bin/env bash
# theme-switch -- apply a named palette across the whole desktop.
#
#   theme-switch            # rofi picker (bound to SUPER+SHIFT+T)
#   theme-switch <name>     # apply a specific palette
#   theme-switch --list     # print available palettes
#   theme-switch --current  # print the active palette
#
# Palettes live in ~/.config/wallust/colorschemes/*.json (pywal format) and are
# the ONLY source -- wallust's ~616 built-in themes are deliberately not offered.
# To add one: `wallust theme <Name> --preview` to read its 16 colours, drop them
# in a new .json here, and it appears in the picker. Nothing else needs editing.
#
# wallust renders every template declared in wallust.toml, then this script
# reloads each consumer. wallust itself has no post-hook support, which is why
# the reloads live here.
#
# Terminal escape sequences are deliberately skipped: alacritty watches its
# imported colors.toml and reloads on its own, and blasting sequences at every
# pty can corrupt running TUI apps.

set -euo pipefail

WALLUST_DIR="$HOME/.config/wallust"
SCHEMES_DIR="$WALLUST_DIR/colorschemes"
CURRENT_FILE="$WALLUST_DIR/current"

die() { printf 'theme-switch: %s\n' "$1" >&2; exit 1; }

# Every palette is a curated file in colorschemes/*.json. wallust also ships
# ~616 built-in themes and this script used to offer all of them, which was
# noise: nobody picks from 616, they look alike once rendered through our
# templates, and none of them can be tweaked. Six were kept, converted to
# colourschemes with `wallust theme <name> --preview`, and the built-in path
# was removed -- so `wallust cs` is now the only way a palette is applied.
list_palettes() {
    [[ -d "$SCHEMES_DIR" ]] || return 0
    for f in "$SCHEMES_DIR"/*.json; do
        [[ -e "$f" ]] || continue
        basename "$f" .json
    done
}

is_curated() { [[ -f "$SCHEMES_DIR/$1.json" ]]; }

current_palette() {
    [[ -r "$CURRENT_FILE" ]] && cat "$CURRENT_FILE" || echo ""
}

# Point every GTK entry point at the palette's built theme. The name changes per
# palette on purpose -- that is what makes a running app re-read the CSS, since
# gtk_css_provider_get_named() caches providers by name forever.
#
# settings.ini and ~/.gtkrc-2.0 are lower-priority than the portal/gsettings
# value at runtime, but they are the fallback when the portal is unavailable and
# the only thing GTK2 reads, so keep all four in step.
set_gtk_theme() {
    local theme="$1"
    [[ -d "$HOME/.local/share/themes/$theme" ]] || return 0

    command -v gsettings >/dev/null 2>&1 &&
        gsettings set org.gnome.desktop.interface gtk-theme "$theme" 2>/dev/null || true

    local f
    for f in "$HOME/.config/gtk-3.0/settings.ini" "$HOME/.config/gtk-4.0/settings.ini"; do
        [[ -w "$f" ]] && sed -i "s/^gtk-theme-name=.*/gtk-theme-name=$theme/" "$f"
    done
    f="$HOME/.gtkrc-2.0"
    [[ -w "$f" ]] && sed -i "s/^gtk-theme-name=.*/gtk-theme-name=\"$theme\"/" "$f"
    return 0
}

reload_gtk() {
    command -v gsettings >/dev/null 2>&1 || return 0
    local key="org.gnome.desktop.interface" theme icons
    theme=$(gsettings get "$key" gtk-theme 2>/dev/null | tr -d "'") || return 0
    icons=$(gsettings get "$key" icon-theme 2>/dev/null | tr -d "'") || return 0

    if [[ -n "$icons" ]]; then
        gsettings set "$key" icon-theme "Adwaita" 2>/dev/null || true
        sleep 0.3
        gsettings set "$key" icon-theme "$icons" 2>/dev/null || true
        # Keep the Cinnamon schema in step so the two can never disagree.
        gsettings set org.cinnamon.desktop.interface icon-theme "$icons" 2>/dev/null || true
    fi

    # NO away-and-back flip for gtk-theme. It used to do one, and it was pure
    # cost: measured on an open Nemo window, the detour repainted 99.07% of the
    # window as Adwaita for ~0.3s and then came back PIXEL-IDENTICAL (0 differing
    # px) to where it started -- a full-window flash for zero net change. The
    # return trip cannot change anything because gtk_css_provider_get_named()
    # serves the same process-cached provider for a name it has already loaded,
    # and ~/.config/gtk-{3,4}.0/gtk.css is read once at app start regardless.
    # The icon flip above is the opposite: GtkIconTheme really does re-read.
    #
    # Mirroring the value into the Cinnamon schema is still worth doing (it had
    # drifted to a nonexistent 'Sweet:dark'); writing an unchanged value emits no
    # change notification, so it costs nothing.
    [[ -n "$theme" ]] &&
        gsettings set org.cinnamon.desktop.interface gtk-theme "$theme" 2>/dev/null || true
}

# Make the login screen match the desktop. Everything here needs root, so it is
# best-effort throughout: `doas -n` never prompts, and a failure must not abort a
# theme switch (the desktop part has already succeeded by then).
#
# THE GREETER RUNS AS uid 968 AND CANNOT READ /home/edargham (mode drwx--x---).
# That is why the theme and icons are copied into /usr/share instead of being
# referenced in place, and why rsync uses -L: the built themes symlink gtk-2.0/
# cinnamon/metacity-1/xfwm4/gnome-shell back into the repo, and an unresolved
# symlink into $HOME is unreadable to the greeter -- regreet would silently fall
# back to Adwaita with no error.
#
# To verify readability afterwards use setpriv, NEVER `doas -u greeter`: that
# tries to AUTHENTICATE and racks up faillock tallies against your own account.
#   doas setpriv --reuid=968 --regid=968 --clear-groups test -r <path>
install_greeter() {
    local name="$1"
    local css="$WALLUST_DIR/generated/regreet.css"
    local theme="$HOME/.local/share/themes/Sweet-$name"
    local icons="$HOME/.local/share/icons/Sweet-Wallust"

    command -v doas >/dev/null 2>&1 || return 0
    doas -n true 2>/dev/null || return 0

    [[ -r "$css" ]] &&
        doas -n install -m 0644 -o root -g root "$css" /etc/greetd/regreet.css 2>/dev/null || true

    command -v rsync >/dev/null 2>&1 || return 0

    # Only what the greeter actually renders. Dropping src/, the SCSS and the
    # inert WM themes keeps this ~2.6 MB instead of pulling the whole tree.
    if [[ -d "$theme" ]]; then
        doas -n rsync -aL --delete \
            --exclude '_render' --exclude '*.scss' --exclude 'src' \
            "$theme/" "/usr/share/themes/Sweet-$name/" 2>/dev/null || true
        # Keep only the active one; otherwise every palette ever used accumulates.
        local d
        for d in /usr/share/themes/Sweet-*/; do
            d="${d%/}"
            case "${d##*/}" in
                "Sweet-$name"|"Sweet-Custom"|"Sweet") continue ;;
                *) doas -n rm -rf "$d" 2>/dev/null || true ;;
            esac
        done
    fi

    [[ -d "$icons" ]] &&
        doas -n rsync -aL --delete "$icons/" /usr/share/icons/Sweet-Wallust/ 2>/dev/null || true

    # Point regreet at them. Both keys are rewritten every switch because the
    # theme name carries the palette; the icon name is stable but is kept in the
    # same place so the two cannot drift.
    if [[ -w /etc/greetd/regreet.toml ]] || doas -n test -f /etc/greetd/regreet.toml 2>/dev/null; then
        doas -n sed -i \
            -e "s|^theme_name = .*|theme_name = \"Sweet-$name\"|" \
            -e "s|^icon_theme_name = .*|icon_theme_name = \"Sweet-Wallust\"|" \
            /etc/greetd/regreet.toml 2>/dev/null || true
    fi
}

apply() {
    local name="$1"

    is_curated "$name" || die "unknown palette '$name' (try --list)"
    wallust cs "$name" --skip-sequences --quiet

    # Compositor: re-executes the Lua config, picking up theme/colors.lua.
    command -v hyprctl >/dev/null 2>&1 && hyprctl reload >/dev/null 2>&1 || true

    # Status bar: SIGUSR2 makes waybar reload config + stylesheet in place.
    pkill -USR2 -x waybar 2>/dev/null || true

    # Notification daemon.
    command -v swaync-client >/dev/null 2>&1 && swaync-client -rs >/dev/null 2>&1 || true

    # Folder icons: recolour Sweet-Wallust from the palette wallust just wrote.
    # Must run BEFORE reload_gtk, which is what makes running apps re-read it.
    [[ -x "$WALLUST_DIR/build-icon-theme" ]] &&
        "$WALLUST_DIR/build-icon-theme" >/dev/null || true

    # GTK widget theme. Normally already built (all palettes are pre-built), so
    # this is a no-op; it only compiles if the palette or the SCSS changed.
    [[ -x "$WALLUST_DIR/build-gtk-theme" ]] &&
        "$WALLUST_DIR/build-gtk-theme" "$name" >/dev/null || true

    set_gtk_theme "Sweet-$name"
    reload_gtk
    install_greeter "$name"

    printf '%s\n' "$name" > "$CURRENT_FILE"

    # Wallpaper last, so its transition plays over an already-restyled desktop.
    # Only swaps if the theme has its own wallpaper (see set-wallpaper).
    [[ -x "$WALLUST_DIR/set-wallpaper" ]] && "$WALLUST_DIR/set-wallpaper" "$name" || true

    printf 'theme-switch: applied %s\n' "$name"

    # Not reloaded here because they read colours at launch: rofi, hyprlock,
    # superfile, and Qt apps. Alacritty reloads itself via its config import.
}

# The active palette is marked so the menu shows what is already applied.
menu_entries() {
    local cur; cur=$(current_palette)
    list_palettes | awk -v cur="$cur" '{ print ($0 == cur ? $0 " (current)" : $0) }'
}

pick() {
    command -v rofi >/dev/null 2>&1 || die "rofi not available; pass a palette name instead"
    local choice n
    n=$(list_palettes | wc -l)
    choice=$(menu_entries | rofi -dmenu -i -p 'Theme' \
                 -theme-str "listview { lines: $n; } window { width: 24%; }")
    [[ -n "${choice:-}" ]] || exit 0
    apply "${choice% (current)}"
}

case "${1-}" in
    ""          ) pick ;;
    --list|-l   ) list_palettes ;;
    --current|-c) current_palette ;;
    # Print the header block, however long it happens to be -- a hardcoded line
    # range silently drifts every time the comment is edited.
    -h|--help   ) awk 'NR>1 && /^#/ { sub(/^# ?/, ""); print; next } NR>1 { exit }' "$0" ;;
    -*          ) die "unknown option '$1'" ;;
    *           ) apply "$1" ;;
esac
