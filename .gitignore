# Tracked subset of ~/.config
#
# Patterns are anchored with a leading "/" so they match only at the repo root.
# An unanchored pattern such as "gtk-*/" also matches nested directories like
# themes/Sweet-Custom/gtk-3.0/, which silently excluded the actual GTK theme
# while still tracking its node_modules. Keep new patterns anchored.

# --- Machine-local application state, caches, and hardware/account data ---
/Code/
/go/
/dconf/
/glib-*/
/gtk-*/
/matplotlib/
# ...but the GTK settings.ini files ARE theming config the desktop depends on
# (see the theming model in CLAUDE.md), so keep those two. `bookmarks` and the
# rest stay excluded as machine-local. Re-inclusion is level by level: git will
# not descend into a directory that is itself excluded.
!/gtk-3.0/
!/gtk-4.0/
/gtk-3.0/*
/gtk-4.0/*
!/gtk-3.0/settings.ini
!/gtk-4.0/settings.ini
# gtk.css is generated by wallust and overrides a subset of the Sweet-Custom
# theme's @define-color names (see wallust/templates/gtk-colors.css). It must be
# tracked: without it a fresh clone has no palette applied to GTK apps.
!/gtk-3.0/gtk.css
!/gtk-4.0/gtk.css
/pulse/
/qalculate/
/OpenRGB/
/vlc/
/warp-terminal/
/xfce4/
/inkscape/
/JetBrains/
/pupgui/
/deluge/
/xdg-desktop-portal/
/GIMP/
/remmina/
/freerdp/
/Google/
/Android Open Source Project/
/Kitware/CMakeSetup.conf

# qt5ct is not installed (Qt5 apps fall back to kvantum-qt5 / qt6ct); its
# config is kept on disk but no longer tracked.
/qt5ct/

# --- Machine-local files ---
/user-dirs.*
/QtProject.conf
/mimeapps.list

# --- systemd: exclude generated *.wants state, keep hand-authored units ---
# Re-inclusion must happen level by level; git will not descend into a
# directory that is itself excluded.
/systemd/*
!/systemd/user/
/systemd/user/*
!/systemd/user/*.service
!/systemd/user/*.target
!/systemd/user/*.service.d/
/systemd/user/*.service.d/*
!/systemd/user/*.service.d/*.conf

# --- Vendored Sweet-Custom theme: keep the theme, drop the npm build tree ---
# node_modules alone is 28M / ~3.4k files and is reproducible from package.json.
/themes/Sweet-Custom/node_modules/
/themes/Sweet-Custom/package-lock.json
*.css.map
*.backup

*.bak

# --- secrets ---
# Tokens and credentials, sourced by zsh/.zshrc. NEVER tracked: this repo has a
# remote. Replaces the plaintext GH_AUTH_TOKEN that used to sit in ~/.bashrc.
/secrets/

# --- zsh: keep the config, drop per-machine state ---
/zsh/.zsh_history
/zsh/.zcompdump*

# --- wallust ---
# Which theme is currently applied is machine-local state. The GENERATED colour
# files it writes (waybar/colors.css, hypr/theme/colors.*, rofi/colors.rasi, ...)
# ARE tracked on purpose: hypr/looknfeel.lua does require("theme/colors"), so an
# untracked colors.lua would leave a fresh clone with a broken compositor config.
/wallust/current
