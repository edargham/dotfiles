// GENERATED FILE -- do not edit.
// Rendered by wallust into ~/.config/fastfetch/config.jsonc.
//
// fastfetch previously ran with no config at all (stock defaults, stock
// colours) on every interactive shell. It now runs once per terminal from
// zsh/.zshrc and is themed from the palette.
//
// NOTE: divider colour comes from each module's "outputColor" rather than an
// inline ANSI escape. JSON forbids raw control characters in strings, so an
// embedded ESC makes fastfetch fail with "unexpected control character".
// fastfetch accepts plain hex here (verified), so no escapes are needed at all.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "type": "small",
    "color": {
      "1": "#5de5ff",
      "2": "#d946ef"
    },
    "padding": { "top": 1, "right": 3 }
  },

  "display": {
    "separator": " ",
    "color": {
      "keys": "#5de5ff",
      "title": "#d946ef"
    }
  },

  "modules": [
    "break",
    { "type": "title", "color": { "user": "#d946ef", "host": "#5de5ff" } },
    { "type": "custom", "format": "────────────────────────────────", "outputColor": "#00b8e6" },

    { "type": "os",       "key": " os     " },
    { "type": "kernel",   "key": " kernel " },
    { "type": "uptime",   "key": " uptime " },
    { "type": "packages", "key": " pkgs   " },
    { "type": "shell",    "key": " shell  " },
    { "type": "wm",       "key": " wm     " },
    { "type": "terminal", "key": " term   " },

    { "type": "custom", "format": "────────────────────────────────", "outputColor": "#00b8e6" },

    { "type": "cpu",      "key": " cpu    " },
    { "type": "gpu",      "key": " gpu    " },
    { "type": "memory",   "key": " memory " },
    { "type": "disk",     "key": " disk   " },
    { "type": "display",  "key": " screen " },

    "break",
    { "type": "colors", "symbol": "circle", "paddingLeft": 1 },
    "break"
  ]
}
