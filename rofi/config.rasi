configuration {
  display-drun: "Applications:";
  display-window: "Windows:";
  display-emoji: "Emoji:";
  display-calc: "Calculate:";
  drun-display-format: "{name}";
  font: "JetBrainsMono Nerd Font Medium 10";
  modi: "window,run,drun,emoji,calc";
  
  // enabling the icons
  show-icons: true;
  // Sweet-Wallust is GENERATED by wallust/build-icon-theme on every theme
  // switch (recoloured Sweet-Purple folders). Stable name, so this stays put.
  icon-theme: "Sweet-Wallust";
}

@theme "/dev/null"

/* Colours come from wallust -- see ~/.config/wallust/wallust.toml.
 * colors.rasi is GENERATED; edit the palette or the template, not it. */
@import "colors.rasi"

* {
  border: 0;
  margin: 0;
  padding: 0;
  spacing: 0;
}

window {
  width: 30%;
  background-color: @bg;
  border-radius: 8px;
}

element {
  padding: 8 12;
  background-color: transparent;
  text-color: @fg-alt;
}

element selected {
  text-color: @fg;
  background-color: @bg-selected;
}

element-text {
  background-color: transparent;
  text-color: inherit;
  vertical-align: 0.5;
}

element-icon {
  size: 14;
  padding: 0 10 0 0;
  background-color: transparent;
}

entry {
  padding: 12;
  background-color: @bg-alt;
  text-color: @fg;
}

inputbar {
  children: [prompt, entry];
  background-color: @bg;
}

listview {
  background-color: @bg;
  columns: 1;
  lines: 10;
}

mainbox {
  children: [inputbar, listview];
  background-color: @bg;
}

prompt {
  enabled: true;
  padding: 12 0 0 12;
  background-color: @bg-alt;
  text-color: @fg;
}

